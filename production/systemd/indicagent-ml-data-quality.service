[Unit]
Description=IndicAgent ML Data Quality Auditor
After=network.target indicagent-infrastructure.target
Requires=indicagent-infrastructure.target

[Service]
Type=oneshot
WorkingDirectory=/home/bg/dev/indicagent
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/data_quality_auditor.py
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
