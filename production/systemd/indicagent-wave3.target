# /home/bg/dev/indicagent/production/systemd/indicagent-wave3.target
# Wave 3: persistence writers - feature-vector-writer
# Does not activate until all wave 2 services have been attempted.
[Unit]
Description=IndicAgent Wave 3 gate — persistence writers
Requires=indicagent-infrastructure.target
After=indicagent-wave2.target
After=indicagent-cross-asset.service
After=indicagent-macro-compute.service

[Install]
WantedBy=multi-user.target
