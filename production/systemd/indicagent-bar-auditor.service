[Unit]
Description=IndicAgent Bar Auditor Agent — gap detection + self-healing via BarGapRequest
After=network-online.target indicagent-bar-writer.service
Wants=indicagent-bar-writer.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
Environment=OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/bar_auditor_agent.py
Restart=always
WatchdogSec=60
NotifyAccess=main
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-bar-auditor
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
