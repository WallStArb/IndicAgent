[Unit]
Description=IndicAgent Calibrator Service — DAG stage 4: isotonic confidence calibration
After=network-online.target indicagent-tod-adjuster.service
Wants=indicagent-tod-adjuster.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/calibrator_service.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-calibrator
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
