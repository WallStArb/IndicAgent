[Unit]
Description=IndicAgent Bar Derivation (grid stage) -- phase 185 D2b, services/bar_derivation.py
After=network.target indicagent-infrastructure.target
Requires=indicagent-infrastructure.target

[Service]
Type=oneshot
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
# D2b grid stage: derive 15m/1h from tradeable 5m, archive-verify-delete-insert per
# symbol. No timer: the IBKR history fetcher (phase 189) runs the grid stage itself after
# a run that inserted 5m rows. Manual invocation of services/bar_derivation.py is
# dry-run-first by default; this unit is the apply path (--changed-only --apply).
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/bar_derivation.py --stage grid --changed-only --apply

[Install]
WantedBy=multi-user.target
