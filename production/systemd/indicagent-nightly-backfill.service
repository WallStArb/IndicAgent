[Unit]
Description=IndicAgent Nightly Incremental OHLCV Backfill
After=network.target indicagent-infrastructure.target
Requires=indicagent-infrastructure.target

[Service]
Type=oneshot
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/bg/dev/indicagent/.venv/bin/python scripts/infrastructure/backfill/infrastructure_nightly_backfill.py

[Install]
WantedBy=multi-user.target
