[Unit]
Description=IndicAgent Bar Reconciliation Audit -- phase 185 D7, services/bar_reconciliation_audit.py
After=network.target indicagent-infrastructure.target
Requires=indicagent-infrastructure.target

[Service]
Type=oneshot
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
# D7 nightly reconciliation: read-only checks reported to integrity_monitor and, through OTel
# metrics labeled by check, to Prometheus. Findings never fail the unit; only a runtime error
# does. No timer: the nightly backfill runs the audit as its last step on every path (D-29),
# so this unit is the manual entry point.
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/bar_reconciliation_audit.py

[Install]
WantedBy=multi-user.target
