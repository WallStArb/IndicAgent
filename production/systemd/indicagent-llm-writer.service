[Unit]
Description=IndicAgent LLM Writer Service — Redis streams to TimescaleDB
After=network-online.target indicagent-wave4.target
Requires=indicagent-infrastructure.target
Wants=network-online.target
Wants=indicagent-feature-writer.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/llm_writer.py
Restart=always
WatchdogSec=60
NotifyAccess=main
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-llm-writer

[Install]
WantedBy=multi-user.target
