[Unit]
Description=IndicAgent LLM Writer Service — Redis streams to TimescaleDB
After=network-online.target indicagent-feature-writer.service
Wants=indicagent-feature-writer.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/llm_writer_service.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-llm-writer

[Install]
WantedBy=multi-user.target
