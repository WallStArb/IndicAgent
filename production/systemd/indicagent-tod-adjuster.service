[Unit]
Description=IndicAgent TOD Adjuster Service — DAG stage 3: time-of-day multipliers
After=network-online.target indicagent-regime-gate.service
Wants=indicagent-regime-gate.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/tod_adjuster_service.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-tod-adjuster
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
