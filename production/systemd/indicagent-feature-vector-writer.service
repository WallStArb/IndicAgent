[Unit]
Description=IndicAgent Feature Vector Writer — persists FeatureVectorRecord to feature_vectors hypertable
After=network-online.target indicagent-wave3.target
Requires=indicagent-infrastructure.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/feature_vector_writer.py
Restart=always
WatchdogSec=60
NotifyAccess=main
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-feature-vector-writer
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
