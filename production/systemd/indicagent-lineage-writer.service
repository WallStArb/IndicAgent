[Unit]
Description=IndicAgent Lineage Writer — persists signal lineage events to signal_lineage (Phase 73)
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/bg/dev/indicagent/.venv/bin/python /home/bg/dev/indicagent/services/lineage_writer_agent.py
Restart=always
RestartSec=10
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-lineage-writer
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
