[Unit]
Description=IndicAgent Narrative Compute (L7 per-signal market narrative generation)
After=network-online.target indicagent-infrastructure.target
Requires=indicagent-infrastructure.target
Wants=network-online.target

[Service]
Type=simple
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/bg/dev/indicagent
EnvironmentFile=-/home/bg/dev/indicagent/.env
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/narrative_swarm.py
Restart=on-failure
WatchdogSec=60
NotifyAccess=main
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-narrative-compute
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
