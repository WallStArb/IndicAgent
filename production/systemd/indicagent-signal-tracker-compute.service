[Unit]
Description=IndicAgent Signal Tracker Compute — evaluate signal lifecycle (DB-ignorant)
After=network-online.target indicagent-wave3.target
Requires=indicagent-infrastructure.target
PartOf=indicagent-intelligence-pipeline.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/signal_tracker.py
Restart=always
TimeoutStopSec=30
WatchdogSec=60
NotifyAccess=main
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-signal-tracker-compute
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
