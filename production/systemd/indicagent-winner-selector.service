[Unit]
Description=IndicAgent Winner Selector Service — DAG stage 6: CIS-based winner selection
After=network-online.target indicagent-ranker.service
Wants=indicagent-ranker.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/winner_selector_service.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-winner-selector
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
