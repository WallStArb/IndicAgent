[Unit]
Description=IndicAgent Tradier Daily Load -- primary 1d source (185-26 nightly leg, own caller since 189-06)
After=network.target indicagent-infrastructure.target
Requires=indicagent-infrastructure.target
# When both are queued together the Tradier load goes first, so names it loads tonight are
# already Tradier-owned when the IBKR fetcher's queue applies its 1d skip.
Before=indicagent-ibkr-history-fetcher.service

[Service]
# The nightly backfill ran this as its first leg until the phase 189 cutover; the IBKR history
# fetcher replaced the nightly's IBKR legs only, so this load keeps its own unit. No IBKR, no
# fetcher lock. --nightly refetches every Tradier-owned name in full plus active equities with
# no 1d bars, and is gated by APR infra.tradier.nightly_enabled (the loader reads it).
# Exit 4 is refusals (ohlcv_load rows the D7 audit's tradier_refused check reports), a finding,
# not a failed unit; 1 is a runtime error.
Type=oneshot
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/bg/dev/indicagent/.venv/bin/python scripts/infrastructure/backfill/infrastructure_run_tradier_daily.py --nightly
SuccessExitStatus=4
# A full nightly refetch measured 106 s for 1,293 names (185-26); the bound catches a hang.
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
