[Unit]
Description=IndicAgent Feature Writer Service — Redpanda to TimescaleDB
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=0

[Service]
Type=simple
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/feature_writer_agent.py
Restart=always
WatchdogSec=60
NotifyAccess=main
TimeoutStopSec=30
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-feature-writer
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
