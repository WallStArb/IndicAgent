[Unit]
Description=IndicAgent Feature Writer Service — Redpanda to TimescaleDB
After=network-online.target indicagent-wave3.target
Requires=indicagent-infrastructure.target
PartOf=indicagent-intelligence-pipeline.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/feature_writer.py
Restart=always
WatchdogSec=60
NotifyAccess=main
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-feature-writer

[Install]
WantedBy=multi-user.target
