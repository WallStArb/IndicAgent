[Unit]
Description=IndicAgent IBKR Provider Agent — broker-agnostic bar publisher
After=network-online.target indicagent-wave1.target
Requires=indicagent-infrastructure.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/bg/dev/indicagent/.venv/bin/python /home/bg/dev/indicagent/services/ibkr_provider.py
Restart=always
WatchdogSec=60
NotifyAccess=main
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-ibkr-provider
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
