[Unit]
Description=IndicAgent Signal Auditor Agent — coverage validation + lag monitoring
After=network-online.target indicagent-wave4.target
Requires=indicagent-infrastructure.target
Wants=network-online.target indicagent-signal-writer.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/signal_auditor.py
Restart=always
WatchdogSec=60
NotifyAccess=main
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-signal-auditor
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
