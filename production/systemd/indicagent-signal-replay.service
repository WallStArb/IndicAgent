[Unit]
Description=IndicAgent Signal Replay Auditor (L9 periodic outcome recovery)
After=network-online.target indicagent-infrastructure.target
Requires=indicagent-infrastructure.target
Wants=network-online.target

[Service]
Type=simple
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
EnvironmentFile=-/home/bg/dev/indicagent/.env
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/signal_replay_auditor.py
Restart=on-failure
WatchdogSec=60
NotifyAccess=main
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-signal-replay
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
