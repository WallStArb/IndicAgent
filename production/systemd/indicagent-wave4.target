# /home/bg/dev/indicagent/production/systemd/indicagent-wave4.target
# Wave 4: analytics, audit, and top-level services
# alerting-agent, dlq-drain, config-service, outbox-dispatcher, self-healing-agent,
# api, dashboard, service-auditor
# Does not activate until all wave 3 services have been attempted.
[Unit]
Description=IndicAgent Wave 4 gate - analytics, audit, and top-level services
Requires=indicagent-infrastructure.target
After=indicagent-wave3.target
After=indicagent-feature-vector-writer.service

[Install]
WantedBy=multi-user.target
