[Unit]
Description=IndicAgent Confidence Calibration Monitor
After=network.target indicagent-infrastructure.target
Requires=indicagent-infrastructure.target

[Service]
Type=oneshot
WorkingDirectory=/home/bg/dev/indicagent
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/confidence_calibration_monitor.py
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
