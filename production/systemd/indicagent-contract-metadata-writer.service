[Unit]
Description=IndicAgent ContractMetadataWriterAgent — contract roll promotion
Requires=indicagent-redpanda-ready.service
After=network-online.target indicagent-roll-compute.service indicagent-redpanda-ready.service
Wants=indicagent-roll-compute.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/contract_metadata_writer_agent.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-contract-metadata-writer
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
