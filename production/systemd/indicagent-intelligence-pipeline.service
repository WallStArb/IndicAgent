[Unit]
Description=IndicAgent Intelligence Pipeline Agent — Unified I1-I7 compute (replaces feature-compute + signal-generator)
After=network-online.target indicagent-wave2.target
Requires=indicagent-infrastructure.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/intelligence_pipeline.py
Restart=always
WatchdogSec=60
NotifyAccess=main
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-intelligence-pipeline
LimitNOFILE=65536
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
