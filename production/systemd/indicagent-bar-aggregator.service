# /etc/systemd/system/indicagent-bar-aggregator.service
[Unit]
Description=IndicAgent Bar Aggregator Agent — 1m->HTF bar aggregation
After=network-online.target indicagent-wave1.target
Requires=indicagent-infrastructure.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/bar_aggregator.py
Restart=always
WatchdogSec=60
NotifyAccess=main
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-bar-aggregator
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
