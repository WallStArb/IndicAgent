[Unit]
Description=IndicAgent Gap-Fill Service
After=network-online.target

[Service]
Type=oneshot
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
Environment=INDICAGENT_ENV=development
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/gap_fill_service.py --lookback-days 5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-gap-fill
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
