[Unit]
Description=IndicAgent Quality Gate Service — DAG stage 1: Hurst/Entropy quality filter
After=network-online.target indicagent-signal-generator.service
Wants=indicagent-signal-generator.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/quality_gate_service.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-quality-gate
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
