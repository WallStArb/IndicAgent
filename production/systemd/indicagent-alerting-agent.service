[Unit]
Description=IndicAgent Alerting Dispatcher — centralized Kafka-to-Telegram/Discord webhook dispatcher
After=network-online.target indicagent-wave4.target
Requires=indicagent-infrastructure.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
Environment=METRICS_PORT=9132
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/alert_monitor.py
Restart=always
WatchdogSec=60
NotifyAccess=main
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-alerting-agent
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
