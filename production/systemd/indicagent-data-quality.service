[Unit]
Description=IndicAgent Data Quality Audit
After=network-online.target

[Service]
Type=oneshot
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/bg/dev/indicagent/.venv/bin/python production/scripts/data_quality_check.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-data-quality
