# /home/bg/dev/indicagent/production/systemd/indicagent-wave1.target
# Wave 1: data ingestion chain — ibkr-provider, bar-replay, provider-merger,
#          bar-aggregator, bar-auditor, bar-writer
# Activates immediately after infrastructure (DB + Kafka) is ready.
# Wave 2 services wait on this target plus the wave 1 service list.
[Unit]
Description=IndicAgent Wave 1 gate — data ingestion chain
Requires=indicagent-infrastructure.target
After=indicagent-infrastructure.target

[Install]
WantedBy=multi-user.target
