[Unit]
Description=IndicAgent Swarm Writer Agent — persist AgentResult shadow predictions
After=network-online.target indicagent-redpanda-ready.service
Requires=indicagent-redpanda-ready.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
Environment=INDICAGENT_ENV=development
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/swarm_writer_agent.py
Restart=always
WatchdogSec=60
NotifyAccess=main
TimeoutStopSec=90
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-swarm-writer
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
