[Unit]
Description=IndicAgent CTX Writer — batch persist qualitative context events and snapshots
After=network-online.target indicagent-wave3.target
Requires=indicagent-infrastructure.target
PartOf=indicagent-intelligence-pipeline.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/context_writer.py
Restart=on-failure
TimeoutStopSec=30
WatchdogSec=60
NotifyAccess=main
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-ctx-writer
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
