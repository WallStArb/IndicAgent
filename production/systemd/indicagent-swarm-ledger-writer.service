[Unit]
Description=IndicAgent Swarm Ledger Writer (L7 AI swarm → signal_ai_enrichment)
After=network-online.target indicagent-wave4.target
Requires=indicagent-infrastructure.target
Wants=network-online.target

[Service]
Type=simple
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/bg/dev/indicagent
EnvironmentFile=-/home/bg/dev/indicagent/.env
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/swarm_ledger_writer.py
Restart=on-failure
WatchdogSec=60
NotifyAccess=main
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-swarm-ledger-writer
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
