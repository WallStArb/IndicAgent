[Unit]
Description=IndicAgent Graduation Writer — batch persist transform_graduation rows
After=network-online.target indicagent-wave4.target
Requires=indicagent-infrastructure.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/graduation_writer.py
Restart=always
TimeoutStopSec=30
WatchdogSec=60
NotifyAccess=main
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-graduation-writer
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
