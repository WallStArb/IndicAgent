[Unit]
Description=IndicAgent Ranker Service — DAG stage 5: performance-weighted signal ranking
After=network-online.target indicagent-calibrator.service
Wants=indicagent-calibrator.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/ranker_service.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-ranker
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
