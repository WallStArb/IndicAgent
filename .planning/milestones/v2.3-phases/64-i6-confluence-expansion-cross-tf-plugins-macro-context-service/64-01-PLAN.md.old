class I6Confluence(BaseModel):
    """I6 cross-timeframe confluence outputs.

    Plugins:
    - CrossTimeframeConfluence (11 existing fields)
    - CrossTFMomentumDivergence (2 new fields)
    - CrossTFSRConfluence (2 new fields)
    - CrossTFRegimeAgreement (2 new fields)
    - SqueezeExpansionDivergence (2 new fields)
    - CrossTFOrderFlowAlignment (2 new fields)
    """

    model_config = ConfigDict(extra="forbid")

    # CrossTimeframeConfluencePlugin outputs (existing)
    ctf_score: float | None = None
    ctf_trend_alignment: float | None = None
    ctf_structure_alignment: float | None = None
    ctf_regime_agreement: float | None = None
    ctf_timeframes_aligned: float | None = None
    ctf_highest_aligned_tf: float | None = None
    i6_smc_bos_alignment: float | None = None
    i6_fvg_tf_alignment: float | None = None
    i6_ob_tf_alignment: float | None = None
    ctf_fvg_alignment: float | None = None
    ctf_ob_alignment: float | None = None
    i6_i2_event_score: float | None = None

    # NEW: CrossTFMomentumDivergencePlugin outputs
    ctf_momentum_divergence: float | None = None  # [-1, +1]
    ctf_momentum_regime: str | None = None  # categorical: aligned_htf_bull, aligned_htf_bear, pullback, bounce, mixed

    # NEW: CrossTFSRConfluencePlugin outputs
    ctf_sr_confluence: float | None = None  # [-1, +1]
    ctf_sr_strongest_level: str | None = None  # categorical: strong, weak, neutral

    # NEW: CrossTFRegimeAgreementPlugin outputs
    ctf_regime_divergence: float | None = None  # [-1, +1]
    ctf_regime_label: str | None = None  # categorical: aligned_trending, aligned_ranging, misaligned

    # NEW: SqueezeExpansionDivergencePlugin outputs
    ctf_squeeze_divergence: float | None = None  # [-1, +1]
    ctf_squeeze_regime: str | None = None  # categorical: squeeze, expansion, neutral

    # NEW: CrossTFOrderFlowAlignmentPlugin outputs
    ctf_orderflow_alignment: float | None = None  # [-1, +1]
    ctf_orderflow_regime: str | None = None  # categorical: aligned_bullish, aligned_bearish, divergent
```

