@dataclass
class CrossTimeframeConfluencePlugin:
    """I6 confluence plugin pattern — in-process transformation, NOT a service.
    
    Plugins run in-process inside IntelligencePipelineComputeAgent (Wave 4).
    They DO NOT extend BaseAgent — they're pure transformation functions.
    Observability comes from parent service (timing, metrics, traces).
    """
    name: str = "i6_CrossTimeframeConfluence"
    outputs: frozenset[str] = frozenset({...})
    min_lookback: int = 1
    supports_incremental: bool = False
    capability_tags: frozenset[str] = frozenset({"confluence"})
    inputs: list[InputSpec] = ()
    _state: dict = field(default_factory=dict)

    def compute_full(self, frames: dict[str, Any]) -> dict[str, Any]:
        """Compute I6 confluence from cached I1-I5 outputs.
        
        Reads:
            frames["intel_i2"] — I2 event signals
            frames["intel_i3"] — I3 pattern signals
            frames["intel_i4"] — I4 GARCH/Kalman context
            frames["intel_i5"] — I5 chart patterns
            frames["intel_i6"] — Previous I6 plugins
        
        Returns:
            dict mapping field names to values (must match outputs frozenset)
        """
```

