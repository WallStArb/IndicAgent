#!/bin/bash
# IndicAgent pre-commit hooks — Renaissance-grade enforcement
# Strict blocking: All checks block commit. No exceptions.
#
# Checks:
#   1. Plugin class naming — class names must end in 'Plugin' suffix
#   2. Plugin file naming — files must use snake_case.py naming
#   3. I7 regime_type validation — I7 plugins must declare regime_type ClassVar
#   4. Ruff lint — full ruff check with auto-fix; re-stages fixed files
#   5. Black format — auto-formats and re-stages; blocks if black not available
#   6. Duplicate test names — same test function in multiple files within a directory
#
# Log: .git/hooks/pre-commit.log (all runs with timestamps)

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
LOG_FILE="${REPO_ROOT}/.git/hooks/pre-commit.log"

# Redirect all output to both console and log file
exec > >(tee -a "$LOG_FILE") 2>&1

echo "=== Pre-commit checks started: $(date -Iseconds) ==="

# Track failures
FAILURES=0

# -----------------------------------------------------------------------------
# Check 1: Plugin class naming — must end in 'Plugin' suffix
#
# Scope: All Python files in src/intelligence/ subdirectories
# Exclusions: Test classes (class.*Test), Data classes (class.*Data),
#             Protocol base classes (class.*Protocol), abstract bases
# -----------------------------------------------------------------------------
check_plugin_class_naming() {
    echo "[1/6] Plugin class naming check..."

    # Find intelligence layer Python files in this commit
    # Exclude: schemas.py (canonical bus schemas — not plugin classes)
    # Exclude: swarm/ (IAlphaContributor classes use Agent/Contributor/Wrapper conventions)
    # Exclude: ai/ (BaseAIAgent subclasses use Agent suffix, not Plugin)
    PYTHON_FILES=$(git diff --cached --name-only --diff-filter=ACM | \
        grep -E '^src/intelligence/.*\.py$' | \
        grep -vE '(schemas|alpha_multiplier)\.py$' | \
        grep -vE '^src/intelligence/swarm/' | \
        grep -vE '^src/intelligence/ai/' || true)

    if [ -z "$PYTHON_FILES" ]; then
        echo "  OK No intelligence layer files changed"
        return 0
    fi

    # Find class declarations not ending with 'Plugin' (ignore Tests, Data, Protocol, Enum classes)
    VIOLATIONS=""
    for file in $PYTHON_FILES; do
        if [ -f "${REPO_ROOT}/${file}" ]; then
            FILE_VIOLATIONS=$(grep -n '^class [A-Z]' "${REPO_ROOT}/${file}" 2>/dev/null | \
                grep -vE 'class.*(Plugin|Agent|Test|Data|Protocol|Enum|Error|Exception|Config|Result|State|Score|Frame|Entry|Event|Spec|Type|Info|Registry|Manager|Builder|Handler|Tracker|Scorer|Aggregat|Transition|Monitor|Stage|Runner|Client|Service|Target|Profile|Weight|Provider|Chain|Candidate|Decision)\b' || true)
            if [ -n "$FILE_VIOLATIONS" ]; then
                VIOLATIONS="${VIOLATIONS}  ${file}:"$'\n'"$(echo "$FILE_VIOLATIONS" | sed 's/^/    /')"$'\n'
            fi
        fi
    done

    if [ -n "$VIOLATIONS" ]; then
        echo "  FAILED: Plugin classes must end with 'Plugin' suffix"
        echo "$VIOLATIONS"
        echo "  Remediation: Rename class to end with 'Plugin' (e.g., 'MACDPlugin')"
        return 1
    fi

    echo "  OK All plugin classes follow naming convention"
    return 0
}

# -----------------------------------------------------------------------------
# Check 2: Plugin file naming — must use snake_case.py
#
# Scope: Files added/modified in src/intelligence/ (excludes __init__, tests, conftest)
# Pattern: ^[a-z][a-z0-9_]*\.py$ (all lowercase with underscores)
# -----------------------------------------------------------------------------
check_plugin_file_naming() {
    echo "[2/6] Plugin file naming check..."

    VIOLATIONS=$(git diff --cached --name-only --diff-filter=ACM | \
        grep -E '^src/intelligence/.*\.py$' | \
        grep -vE '^src/intelligence/(ai|swarm)/' | \
        while read -r filepath; do
            filename=$(basename "$filepath")
            # Allow: snake_case.py, __init__.py, test_*.py, conftest.py
            if echo "$filename" | grep -qvE '^([a-z][a-z0-9_]*|__init__|conftest)\.py$'; then
                echo "  $filepath"
            fi
        done || true)

    if [ -n "$VIOLATIONS" ]; then
        echo "  FAILED: Plugin files must use snake_case.py naming"
        echo "$VIOLATIONS"
        echo "  Remediation: Rename file to snake_case.py (e.g., 'bollinger_bands.py')"
        return 1
    fi

    echo "  OK All plugin files follow naming convention"
    return 0
}

# -----------------------------------------------------------------------------
# Check 3: I7 regime_type validation
#
# Scope: Files in src/intelligence/trading/*.py (I7 plugins only)
# Requirement: Must contain 'regime_type' ClassVar declaration
# Exclusions: __init__.py, signal_ledger.py, lifecycle_tracker.py, trade_framer.py
#             (infrastructure files, not plugins)
# -----------------------------------------------------------------------------
check_regime_type_declaration() {
    echo "[3/6] I7 regime_type check..."

    # Find I7 plugin files in this commit (exclude infrastructure files)
    I7_FILES=$(git diff --cached --name-only --diff-filter=ACM | \
        grep -E '^src/intelligence/trading/[a-z][a-z0-9_]*\.py$' | \
        grep -vE '(signal_ledger|lifecycle_tracker|trade_framer|signal_aggregator|cis_scorer|weight_updater|confidence_calibrator|__init__)\.py$' || true)

    if [ -z "$I7_FILES" ]; then
        echo "  OK No I7 trading plugins changed"
        return 0
    fi

    FAILURES_LOCAL=0
    for file in $I7_FILES; do
        if [ -f "${REPO_ROOT}/${file}" ]; then
            # Check if the file defines a Plugin class (skip non-plugin files)
            if ! grep -q '^class.*Plugin' "${REPO_ROOT}/${file}" 2>/dev/null; then
                continue  # Not a plugin file, skip
            fi

            # Check for regime_type declaration (ClassVar or plain class attribute)
            if ! grep -qE 'regime_type\s*[:=]' "${REPO_ROOT}/${file}"; then
                echo "  FAILED: I7 plugin missing regime_type declaration"
                echo "    File: ${file}"
                echo "    Remediation: Add 'regime_type: ClassVar[str] = \"trend\" | \"mean_reversion\" | \"any\"'"
                FAILURES_LOCAL=$((FAILURES_LOCAL + 1))
            fi
        fi
    done

    if [ $FAILURES_LOCAL -gt 0 ]; then
        return 1
    fi

    echo "  OK All I7 plugins declare regime_type"
    return 0
}

# -----------------------------------------------------------------------------
# Check 4: Ruff lint (full check with auto-fix)
#
# Scope: All Python files in this commit
# Tool: ruff check --fix (auto-fixes safe violations, blocks on unfixable)
# Re-stages any files ruff modifies so the commit includes the fixes.
# -----------------------------------------------------------------------------
check_ruff_lint() {
    echo "[4/6] Ruff lint check..."

    CHANGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | \
        grep -E '\.py$' || true)

    if [ -z "$CHANGED_PY_FILES" ]; then
        echo "  OK No Python files changed"
        return 0
    fi

    FULL_PATHS=""
    for file in $CHANGED_PY_FILES; do
        if [ -f "${REPO_ROOT}/${file}" ]; then
            FULL_PATHS="${FULL_PATHS} ${REPO_ROOT}/${file}"
        fi
    done

    if [ -z "$FULL_PATHS" ]; then
        echo "  OK No Python files found on disk"
        return 0
    fi

    RUFF_BIN="${REPO_ROOT}/.venv/bin/ruff"
    if [ ! -x "$RUFF_BIN" ]; then
        RUFF_BIN=$(which ruff 2>/dev/null || echo "")
    fi

    if [ -z "$RUFF_BIN" ]; then
        echo "  BLOCKED: ruff not found — cannot enforce lint"
        echo "  Install: pip install ruff"
        return 1
    fi

    # Auto-fix what ruff can, then re-stage those files
    "$RUFF_BIN" check --fix $FULL_PATHS 2>/dev/null || true
    for file in $CHANGED_PY_FILES; do
        if [ -f "${REPO_ROOT}/${file}" ]; then
            git add "${REPO_ROOT}/${file}"
        fi
    done

    # Now check for remaining unfixable violations
    RUFF_TMPFILE=$(mktemp)
    "$RUFF_BIN" check $FULL_PATHS >"$RUFF_TMPFILE" 2>&1
    RUFF_EXIT=$?

    if [ $RUFF_EXIT -ne 0 ]; then
        echo "  FAILED: Ruff lint violations (could not auto-fix)"
        grep -v "^All checks passed" "$RUFF_TMPFILE" | while read -r line; do
            echo "    $line"
        done
        rm -f "$RUFF_TMPFILE"
        echo "  Remediation: Fix violations manually, then re-commit"
        return 1
    fi

    rm -f "$RUFF_TMPFILE"
    echo "  OK Ruff lint passed"
    return 0
}

# -----------------------------------------------------------------------------
# Check 5: Black format (auto-format with re-stage)
#
# Scope: All Python files in this commit
# Tool: black (auto-formats in place, re-stages modified files)
# Blocks if black is not available.
# -----------------------------------------------------------------------------
check_black_format() {
    echo "[5/6] Black format check..."

    CHANGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | \
        grep -E '\.py$' || true)

    if [ -z "$CHANGED_PY_FILES" ]; then
        echo "  OK No Python files changed"
        return 0
    fi

    FULL_PATHS=""
    for file in $CHANGED_PY_FILES; do
        if [ -f "${REPO_ROOT}/${file}" ]; then
            FULL_PATHS="${FULL_PATHS} ${REPO_ROOT}/${file}"
        fi
    done

    if [ -z "$FULL_PATHS" ]; then
        echo "  OK No Python files found on disk"
        return 0
    fi

    BLACK_BIN="${REPO_ROOT}/.venv/bin/black"
    if [ ! -x "$BLACK_BIN" ]; then
        BLACK_BIN=$(which black 2>/dev/null || echo "")
    fi

    if [ -z "$BLACK_BIN" ]; then
        echo "  BLOCKED: black not found — cannot enforce formatting"
        echo "  Install: pip install black"
        return 1
    fi

    # Auto-format, then re-stage so the commit contains formatted code
    "$BLACK_BIN" $FULL_PATHS 2>/dev/null
    for file in $CHANGED_PY_FILES; do
        if [ -f "${REPO_ROOT}/${file}" ]; then
            git add "${REPO_ROOT}/${file}"
        fi
    done

    echo "  OK Black format applied"
    return 0
}

# -----------------------------------------------------------------------------
# Check 6: Duplicate test function names (within-directory scope)
#
# Scope: tests/unit/ — runs on every commit (not scoped to changed files,
#        since a rename in one file can create a duplicate in another).
# Tool: tools/check_duplicate_tests.py
# Allowlist: tools/duplicate_test_allowlist.txt (structural boilerplate exemptions)
# -----------------------------------------------------------------------------
check_duplicate_tests() {
    echo "[6/6] Duplicate test names check..."

    STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$' || true)
    if [ -z "$STAGED_PY" ]; then
        echo "  SKIPPED: no Python files staged"
        return 0
    fi

    PYTHON_BIN="${REPO_ROOT}/.venv/bin/python"
    if [ ! -x "$PYTHON_BIN" ]; then
        PYTHON_BIN=$(which python3 2>/dev/null || echo "")
    fi

    if [ -z "$PYTHON_BIN" ]; then
        echo "  SKIPPED: python not found"
        return 0
    fi

    SCRIPT="${REPO_ROOT}/tools/check_duplicate_tests.py"
    if [ ! -f "$SCRIPT" ]; then
        echo "  SKIPPED: tools/check_duplicate_tests.py not found"
        return 0
    fi

    if ! "$PYTHON_BIN" "$SCRIPT"; then
        echo "  Remediation: rename duplicate tests or add exemption to tools/duplicate_test_allowlist.txt"
        return 1
    fi

    return 0
}

# -----------------------------------------------------------------------------
# Run all checks — all must pass for commit to proceed
# -----------------------------------------------------------------------------
check_plugin_class_naming || FAILURES=$((FAILURES + 1))
check_plugin_file_naming || FAILURES=$((FAILURES + 1))
check_regime_type_declaration || FAILURES=$((FAILURES + 1))
check_ruff_lint || FAILURES=$((FAILURES + 1))
check_black_format || FAILURES=$((FAILURES + 1))
check_duplicate_tests || FAILURES=$((FAILURES + 1))

echo "=== Pre-commit checks completed: $(date -Iseconds) ==="

if [ $FAILURES -gt 0 ]; then
    echo ""
    echo "BLOCKED: Pre-commit hooks failed: $FAILURES check(s) violated"
    echo "Fix violations and try again. See ${LOG_FILE} for details."
    exit 1
fi

echo "PASSED: All pre-commit checks passed"
exit 0
