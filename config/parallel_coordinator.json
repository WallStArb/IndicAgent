{
  "services": {
    "timeframe_builder": {
      "enabled": true,
      "config_file": "config/timeframe_builder_service.json"
    },
    "indicator_processor": {
      "enabled": true, 
      "config_file": "config/indicator_processor_service.json"
    }
  },
  "coordinator": {
    "health_check_interval": 30,
    "startup_delay": 2,
    "shutdown_timeout": 10
  },
  "logging": {
    "level": "INFO",
    "file": "logs/parallel_coordinator.log"
  }
}