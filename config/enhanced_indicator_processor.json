{
  "redis": {
    "host": "localhost",
    "port": 6379,
    "db": 0
  },
  "database": {
    "url": "postgresql://postgres:postgres@localhost:5432/indicagent"
  },
  "service": {
    "symbols": ["ESH6", "NQH6", "RTYH6", "CLH6", "NGH6", "GCJ6", "SIH6", "HGH6", "PLJ6", "VXH6"],
    "timeframes": ["1m", "5m", "15m", "1h", "4h", "1d"],
    "indicators": [
      "RSI",
      "MACD",
      "MACD_SIGNAL",
      "MACD_HISTOGRAM",
      "BB_UPPER",
      "BB_MIDDLE",
      "BB_LOWER",
      "SMA_20",
      "SMA_50",
      "SMA_200",
      "EMA_12",
      "EMA_26",
      "EMA_50",
      "ATR",
      "STOCH_K",
      "STOCH_D"
    ],
    "processing_interval": 0.05,
    "health_check_interval": 30,
    "min_history_bars": 200,
    "use_incremental": true,
    "fallback_threshold": 50,
    "indicator_stream_maxlen": 200000
  },
  "logging": {
    "level": "INFO",
    "file": "logs/enhanced_indicator_processor.log",
    "max_size": "10MB",
    "backup_count": 5
  }
}
