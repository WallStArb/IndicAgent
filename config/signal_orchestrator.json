{
  "redis": {
    "host": "localhost",
    "port": 6379,
    "db": 0
  },
  "database": {
    "url": "postgresql://postgres:postgres@localhost:5432/indicagent"
  },
  "service": {
    "symbols": ["ESH6", "NQH6", "RTYH6"],
    "timeframes": ["5m", "15m"],
    "min_history_bars": 50,
    "processing_interval": 0.1,
    "health_check_interval": 30
  },
  "logging": {
    "level": "INFO",
    "file": "logs/signal_orchestrator.log",
    "max_size": "10MB",
    "backup_count": 5
  }
}
