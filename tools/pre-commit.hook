#!/bin/bash
# IndicAgent pre-commit hooks — Renaissance-grade enforcement
# Strict blocking: All checks block commit. No exceptions.
#
# Checks:
#   1. Plugin class naming — class names must end in 'Plugin' suffix
#   2. Plugin file naming — files must use snake_case.py naming
#   3. I7 regime_type validation — I7 plugins must declare regime_type ClassVar
#   4. Ruff lint — full ruff check with auto-fix; re-stages fixed files
#   5. Black format — auto-formats and re-stages; blocks if black not available
#   6. Duplicate test names — same test function in multiple files within a directory
#   7. Ring 0 boundary check — src/core/ and src/observability/ must not import domain layers
#   8. Glossary enforcement — banned synonyms blocked in .py and .md files
#   9. Counterfactual-ledger enforcement — no new parallel claim/event/frame table
#
# Log: logs/pre-commit.log (all runs with timestamps)
# Renaissance-grade: logs live in repo logs/, not in .git/ infrastructure

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
LOG_FILE="${REPO_ROOT}/logs/pre-commit.log"

# Redirect all output to both console and log file
exec > >(tee -a "$LOG_FILE") 2>&1

echo "=== Pre-commit checks started: $(date -Iseconds) ==="

# Track failures
FAILURES=0

# -----------------------------------------------------------------------------
# Check 1: Plugin class naming — must end in 'Plugin' suffix
#
# Scope: All Python files in src/intelligence/ subdirectories
# Exclusions: Test classes (class.*Test), Data classes (class.*Data),
#             Protocol base classes (class.*Protocol), abstract bases
# -----------------------------------------------------------------------------
check_plugin_class_naming() {
    echo "[1/9] Plugin class naming check..."

    PYTHON_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^src/intelligence/.*\.py$' || true)

    if [ -z "$PYTHON_FILES" ]; then
        echo "  OK No intelligence layer files changed"
        return 0
    fi

    OUTPUT=$(echo "$PYTHON_FILES" | "${REPO_ROOT}/tools/check_plugin_invariants.sh" class-naming)
    STATUS=$?
    echo "$OUTPUT" | sed 's/^OK:/  OK/; s/^FAIL:/  FAILED:/'
    if [ $STATUS -ne 0 ]; then
        echo "  Remediation: rename class to an approved suffix (e.g., 'MACDPlugin', 'FeatureVectorRecord')"
        return 1
    fi
    return 0
}

# -----------------------------------------------------------------------------
# Check 2: Plugin file naming — must use snake_case.py
#
# Scope: Files added/modified in src/intelligence/ (excludes __init__, tests, conftest)
# Pattern: ^[a-z][a-z0-9_]*\.py$ (all lowercase with underscores)
# -----------------------------------------------------------------------------
check_plugin_file_naming() {
    echo "[2/9] Plugin file naming check..."

    PYTHON_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^src/intelligence/.*\.py$' || true)

    if [ -z "$PYTHON_FILES" ]; then
        echo "  OK No intelligence layer files changed"
        return 0
    fi

    OUTPUT=$(echo "$PYTHON_FILES" | "${REPO_ROOT}/tools/check_plugin_invariants.sh" file-naming)
    STATUS=$?
    echo "$OUTPUT" | sed 's/^OK:/  OK/; s/^FAIL:/  FAILED:/'
    if [ $STATUS -ne 0 ]; then
        echo "  Remediation: rename file to snake_case.py (e.g., 'bollinger_bands.py')"
        return 1
    fi
    return 0
}

# -----------------------------------------------------------------------------
# Check 3: I7 regime_type validation
#
# Scope: Files in src/intelligence/trading/*.py (I7 plugins only)
# Requirement: Must contain 'regime_type' ClassVar declaration
# Exclusions: __init__.py, signal_ledger.py, lifecycle_tracker.py, trade_framer.py
#             (infrastructure files, not plugins)
# -----------------------------------------------------------------------------
check_regime_type_declaration() {
    echo "[3/9] I7 regime_type check..."

    I7_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^src/intelligence/trading/.*\.py$' || true)

    if [ -z "$I7_FILES" ]; then
        echo "  OK No I7 trading plugins changed"
        return 0
    fi

    OUTPUT=$(echo "$I7_FILES" | "${REPO_ROOT}/tools/check_plugin_invariants.sh" regime-type)
    STATUS=$?
    echo "$OUTPUT" | sed 's/^OK:/  OK/; s/^FAIL:/  FAILED:/'
    if [ $STATUS -ne 0 ]; then
        echo "  Remediation: add 'regime_type: ClassVar[str] = \"trend\" | \"mean_reversion\" | \"any\"'"
        return 1
    fi
    return 0
}

# -----------------------------------------------------------------------------
# Check 4: Ruff lint (full check with auto-fix)
#
# Scope: All Python files in this commit
# Tool: ruff check --fix (auto-fixes safe violations, blocks on unfixable)
# Re-stages any files ruff modifies so the commit includes the fixes.
# -----------------------------------------------------------------------------
check_ruff_lint() {
    echo "[4/9] Ruff lint check..."

    CHANGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | \
        grep -E '\.py$' || true)

    if [ -z "$CHANGED_PY_FILES" ]; then
        echo "  OK No Python files changed"
        return 0
    fi

    FULL_PATHS=""
    for file in $CHANGED_PY_FILES; do
        if [ -f "${REPO_ROOT}/${file}" ]; then
            FULL_PATHS="${FULL_PATHS} ${REPO_ROOT}/${file}"
        fi
    done

    if [ -z "$FULL_PATHS" ]; then
        echo "  OK No Python files found on disk"
        return 0
    fi

    RUFF_BIN="${REPO_ROOT}/.venv/bin/ruff"
    if [ ! -x "$RUFF_BIN" ]; then
        RUFF_BIN=$(which ruff 2>/dev/null || echo "")
    fi

    if [ -z "$RUFF_BIN" ]; then
        echo "  BLOCKED: ruff not found — cannot enforce lint"
        echo "  Install: pip install ruff"
        return 1
    fi

    # Auto-fix what ruff can, then re-stage those files
    "$RUFF_BIN" check --fix $FULL_PATHS 2>/dev/null || true
    for file in $CHANGED_PY_FILES; do
        if [ -f "${REPO_ROOT}/${file}" ]; then
            git add "${REPO_ROOT}/${file}"
        fi
    done

    # Now check for remaining unfixable violations
    RUFF_TMPFILE=$(mktemp)
    "$RUFF_BIN" check $FULL_PATHS >"$RUFF_TMPFILE" 2>&1
    RUFF_EXIT=$?

    if [ $RUFF_EXIT -ne 0 ]; then
        echo "  FAILED: Ruff lint violations (could not auto-fix)"
        grep -v "^All checks passed" "$RUFF_TMPFILE" | while read -r line; do
            echo "    $line"
        done
        rm -f "$RUFF_TMPFILE"
        echo "  Remediation: Fix violations manually, then re-commit"
        return 1
    fi

    rm -f "$RUFF_TMPFILE"
    echo "  OK Ruff lint passed"
    return 0
}

# -----------------------------------------------------------------------------
# Check 5: Black format (auto-format with re-stage)
#
# Scope: All Python files in this commit
# Tool: black (auto-formats in place, re-stages modified files)
# Blocks if black is not available.
# -----------------------------------------------------------------------------
check_black_format() {
    echo "[5/9] Black format check..."

    CHANGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | \
        grep -E '\.py$' || true)

    if [ -z "$CHANGED_PY_FILES" ]; then
        echo "  OK No Python files changed"
        return 0
    fi

    FULL_PATHS=""
    for file in $CHANGED_PY_FILES; do
        if [ -f "${REPO_ROOT}/${file}" ]; then
            FULL_PATHS="${FULL_PATHS} ${REPO_ROOT}/${file}"
        fi
    done

    if [ -z "$FULL_PATHS" ]; then
        echo "  OK No Python files found on disk"
        return 0
    fi

    BLACK_BIN="${REPO_ROOT}/.venv/bin/black"
    if [ ! -x "$BLACK_BIN" ]; then
        BLACK_BIN=$(which black 2>/dev/null || echo "")
    fi

    if [ -z "$BLACK_BIN" ]; then
        echo "  BLOCKED: black not found — cannot enforce formatting"
        echo "  Install: pip install black"
        return 1
    fi

    # Auto-format, then re-stage so the commit contains formatted code
    "$BLACK_BIN" $FULL_PATHS 2>/dev/null
    for file in $CHANGED_PY_FILES; do
        if [ -f "${REPO_ROOT}/${file}" ]; then
            git add "${REPO_ROOT}/${file}"
        fi
    done

    echo "  OK Black format applied"
    return 0
}

# -----------------------------------------------------------------------------
# Check 6: Duplicate test function names (within-directory scope)
#
# Scope: tests/unit/ — runs on every commit (not scoped to changed files,
#        since a rename in one file can create a duplicate in another).
# Tool: tools/check_duplicate_tests.py
# Allowlist: tools/duplicate_test_allowlist.txt (structural boilerplate exemptions)
# -----------------------------------------------------------------------------
check_duplicate_tests() {
    echo "[6/9] Duplicate test names check..."

    PYTHON_BIN="${REPO_ROOT}/.venv/bin/python"
    if [ ! -x "$PYTHON_BIN" ]; then
        PYTHON_BIN=$(which python3 2>/dev/null || echo "")
    fi

    if [ -z "$PYTHON_BIN" ]; then
        echo "  SKIPPED: python not found"
        return 0
    fi

    SCRIPT="${REPO_ROOT}/tools/check_duplicate_tests.py"
    if [ ! -f "$SCRIPT" ]; then
        echo "  SKIPPED: tools/check_duplicate_tests.py not found"
        return 0
    fi

    if ! "$PYTHON_BIN" "$SCRIPT"; then
        echo "  Remediation: rename duplicate tests or add exemption to tools/duplicate_test_allowlist.txt"
        return 1
    fi

    return 0
}


# -----------------------------------------------------------------------------
# Ring 0 boundary check: src/core/ and src/observability/ must not import domain layers
#
# Scope: All Python files in src/core/ and src/observability/
# Exclusions: commented-out imports, ring0-ok-annotated lazy imports
# Pattern: enforces that Ring 0 infrastructure never imports Ring 1+ domain code
# -----------------------------------------------------------------------------
check_ring0_boundary() {
    echo "[7/9] Ring 0 boundary check..."

    OUTPUT=$("${REPO_ROOT}/tools/check_plugin_invariants.sh" ring0-boundary)
    STATUS=$?
    echo "$OUTPUT" | sed 's/^OK:/  OK/; s/^FAIL:/  FAILED:/'
    if [ $STATUS -ne 0 ]; then
        return 1
    fi
    return 0
}

# -----------------------------------------------------------------------------
# Check 8: Glossary enforcement — banned synonyms must not appear in staged files
#
# Scope: All .py and .md files in this commit
# Tool: tools/check_glossary.py
# Blocks on any banned term (active, deprecated, or retired) in prose or identifiers
# -----------------------------------------------------------------------------
check_glossary_terms() {
    echo "[8/9] Glossary enforcement check..."

    CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | \
        grep -E '\.(py|md)$' | \
        grep -vE '(\.venv|node_modules|\.git|__pycache__)' | \
        grep -vE '^docs/(ideas|plans)/archive/' || true)

    if [ -z "$CHANGED_FILES" ]; then
        echo "  OK No Python or Markdown files changed"
        return 0
    fi

    PYTHON_BIN="${REPO_ROOT}/.venv/bin/python"
    if [ ! -x "$PYTHON_BIN" ]; then
        PYTHON_BIN=$(which python3 2>/dev/null || echo "")
    fi

    if [ -z "$PYTHON_BIN" ]; then
        echo "  SKIPPED: python not found"
        return 0
    fi

    SCRIPT="${REPO_ROOT}/tools/check_glossary.py"

    if [ ! -f "$SCRIPT" ]; then
        echo "  SKIPPED: tools/check_glossary.py not found"
        return 0
    fi

    FULL_PATHS=""
    for file in $CHANGED_FILES; do
        if [ -f "${REPO_ROOT}/${file}" ]; then
            FULL_PATHS="${FULL_PATHS} ${REPO_ROOT}/${file}"
        fi
    done

    if [ -z "$FULL_PATHS" ]; then
        echo "  OK No files found on disk"
        return 0
    fi

    if ! "$PYTHON_BIN" "$SCRIPT" $FULL_PATHS; then
        echo "  Remediation: Replace banned term with the canonical glossary term."
        echo "  Reference: docs/foundation/glossary.md"
        return 1
    fi

    echo "  OK Glossary terms clean"
    return 0
}

# -----------------------------------------------------------------------------
# Check 9: Counterfactual-ledger enforcement — no new parallel claim/event/frame
#           table without explicit justification
#
# Scope: New CREATE TABLE statements in staged .sql migration files
# Invariant: docs/research/canonical-simulator.md's binding rule — "no validation
#            client builds its own replay or counterfactual path; counterfactual
#            P&L claims are alpha_frames rows, new shapes are frame_variants,
#            never new tables or services." A new table shaped like a claim
#            ledger (events/frames/claims/occurrences/outcomes/ledger suffix) is
#            exactly the silent-drift failure mode that invariant exists to
#            block (see also: signal_outcomes was dropped in favor of
#            signal_ledger in Phase 130 — this codebase has hit this before).
# Escape hatch: a `-- LEDGER-EXCEPTION: <reason>` comment on the line
#            immediately before or after the CREATE TABLE statement.
# -----------------------------------------------------------------------------
check_counterfactual_ledger() {
    echo "[9/9] Counterfactual-ledger enforcement check..."

    SQL_FILES=$(git diff --cached --name-only --diff-filter=ACM | \
        grep -E '\.sql$' | \
        grep -E '(migrations?)/' || true)

    if [ -z "$SQL_FILES" ]; then
        echo "  OK No migration files changed"
        return 0
    fi

    # Existing, already-legitimate ledger-shaped tables — not new drift.
    ALLOWLIST='^(alpha_events|alpha_frames|signal_ledger|signal_events|trade_frames|trade_executions|llm_calls|config_history|concept_transition_log)$'

    FAILURES_LOCAL=0
    for file in $SQL_FILES; do
        [ -f "${REPO_ROOT}/${file}" ] || continue

        # Extract table names from CREATE TABLE statements (with or without IF NOT EXISTS)
        TABLES=$(grep -ioE 'CREATE TABLE( IF NOT EXISTS)? [a-zA-Z_][a-zA-Z0-9_]*' "${REPO_ROOT}/${file}" | \
            awk '{print $NF}')

        for table in $TABLES; do
            table_lc=$(echo "$table" | tr '[:upper:]' '[:lower:]')

            if echo "$table_lc" | grep -qE "$ALLOWLIST"; then
                continue
            fi

            if echo "$table_lc" | grep -qE '(_events|_frames|_claims|_occurrences|_outcomes|_ledger)$'; then
                if grep -qE '^\s*--\s*LEDGER-EXCEPTION:' "${REPO_ROOT}/${file}"; then
                    continue
                fi
                echo "  FAILED: new table '${table}' looks like a parallel claim/event ledger"
                echo "    File: ${file}"
                echo "    Rule: docs/research/canonical-simulator.md — counterfactual claims are"
                echo "      alpha_frames rows; new shapes are frame_variants, not new tables."
                echo "    Remediation: extend alpha_frames with a frame_variant instead, or if"
                echo "      this table is genuinely a different concept, add a comment:"
                echo "      -- LEDGER-EXCEPTION: <why this is not a frame_variant>"
                FAILURES_LOCAL=$((FAILURES_LOCAL + 1))
            fi
        done
    done

    if [ $FAILURES_LOCAL -gt 0 ]; then
        return 1
    fi

    echo "  OK No unjustified parallel ledger tables"
    return 0
}

# -----------------------------------------------------------------------------
# Run all checks — all must pass for commit to proceed
# -----------------------------------------------------------------------------
check_plugin_class_naming || FAILURES=$((FAILURES + 1))
check_plugin_file_naming || FAILURES=$((FAILURES + 1))
check_regime_type_declaration || FAILURES=$((FAILURES + 1))
check_ruff_lint || FAILURES=$((FAILURES + 1))
check_black_format || FAILURES=$((FAILURES + 1))
check_duplicate_tests || FAILURES=$((FAILURES + 1))
check_ring0_boundary || FAILURES=$((FAILURES + 1))
check_glossary_terms || FAILURES=$((FAILURES + 1))
check_counterfactual_ledger || FAILURES=$((FAILURES + 1))

echo "=== Pre-commit checks completed: $(date -Iseconds) ==="

if [ $FAILURES -gt 0 ]; then
    echo ""
    echo "BLOCKED: Pre-commit hooks failed: $FAILURES check(s) violated"
    echo "Fix violations and try again. See logs/pre-commit.log for details."
    exit 1
fi

echo "PASSED: All pre-commit checks passed"
