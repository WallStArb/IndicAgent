# =============================================================================
# IndicAgent Platform - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# Environment Control
INDICAGENT_ENV=development    # development | staging | production

# Database (PostgreSQL/TimescaleDB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/indicagent

# Redis (DragonflyDB)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Interactive Brokers (TWS)
IBKR_HOST=172.18.176.1       # WSL2: Windows host IP
IBKR_PORT=7497                # 7497=paper, 7496=live
IBKR_CLIENT_ID=35             # Unique client ID (35+ range recommended)

# OpenTelemetry (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=

# AI Integration (optional, for future I8 tier)
# OPENROUTER_API_KEY=your_key_here
