[Unit]
Description=IndicAgent Parallel Service Coordinator
After=network.target
Wants=network.target

[Service]
Type=exec
WorkingDirectory=/home/bg/projects/indicagent
Environment=PATH=/home/bg/projects/indicagent/.venv/bin
Environment=PYTHONPATH=/home/bg/projects/indicagent
ExecStart=/home/bg/projects/indicagent/.venv/bin/python services/coordination_parallel_service.py --config config/parallel_coordinator.json

# Restart behavior
Restart=always
RestartSec=10
StartLimitBurst=5
StartLimitIntervalSec=300

# Resource limits
MemoryMax=2G
CPUQuota=200%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-parallel

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/bg/projects/indicagent/logs
ReadWritePaths=/home/bg/projects/indicagent/data

[Install]
WantedBy=multi-user.target