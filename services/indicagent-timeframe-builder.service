[Unit]
Description=IndicAgent Timeframe Builder Service - Multi-timeframe Bar Building
Documentation=https://github.com/your-org/indicagent
After=network-online.target indicagent-hf-tws.service
Wants=network-online.target
Requires=indicagent-hf-tws.service

PartOf=indicagent-master.service
StartLimitIntervalSec=0

[Service]
Type=exec
WorkingDirectory=/home/bg/projects/indicagent
Environment=PYTHONPATH=/home/bg/projects/indicagent
Environment=DATABASE_URL=postgresql://postgres:postgres@localhost:5432/indicagent
Environment=REDIS_URL=redis://localhost:6379/0
ExecStart=/home/bg/projects/indicagent/.venv/bin/python /home/bg/projects/indicagent/services/timeframes_builder_service.py --config /home/bg/projects/indicagent/config/timeframe_builder_service.json

# Health check
ExecStartPost=/bin/sleep 5
ExecStartPost=/bin/bash -c 'timeout 30 bash -c "until curl -f http://localhost:9110/health; do sleep 2; done"'

# Restart configuration
Restart=on-failure
RestartSec=15
StartLimitBurst=3

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/bg/projects/indicagent/logs
ReadOnlyPaths=/home/bg/projects/indicagent

# Resource limits
MemoryMax=1G
CPUQuota=200%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-timeframe-builder

[Install]
WantedBy=multi-user.target