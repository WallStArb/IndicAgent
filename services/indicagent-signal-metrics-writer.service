[Unit]
Description=IndicAgent Signal Metrics Writer Agent — persists signal metrics events to DB
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
Environment=OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/signal_metrics_writer_agent.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-signal-metrics-writer
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
