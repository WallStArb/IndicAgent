[Unit]
Description=IndicAgent Indicator Compute Agent -- I1 technical indicator computation
After=network-online.target indicagent-tws.service
Wants=indicagent-tws.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bg
WorkingDirectory=/home/bg/dev/indicagent
Environment=PYTHONPATH=/home/bg/dev/indicagent
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/bg/dev/indicagent/.venv/bin/python services/indicator_compute_agent.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-indicator-compute
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
