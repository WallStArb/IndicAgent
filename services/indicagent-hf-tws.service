[Unit]
Description=IndicAgent High-Frequency IBKR TWS Daemon
After=network-online.target
Wants=network-online.target

PartOf=indicagent-master.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/bg/projects/indicagent
Environment=PYTHONPATH=/home/bg/projects/indicagent
Environment=INDICAGENT_ENV=prod
Environment=INDICAGENT_METRICS_PORT=9108
ExecStart=/home/bg/projects/indicagent/.venv/bin/python /home/bg/projects/indicagent/production/daemons/high_frequency_tws_daemon.py --client-id 35

# Health check
ExecStartPost=/bin/sleep 10
ExecStartPost=/bin/bash -c 'timeout 30 bash -c "until curl -f http://localhost:9108/metrics; do sleep 2; done"'

# Restart configuration 
Restart=on-failure
RestartSec=10
StartLimitBurst=3

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/bg/projects/indicagent/logs
ReadOnlyPaths=/home/bg/projects/indicagent

# Resource limits
MemoryMax=1G
CPUQuota=300%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicagent-hf-tws

[Install]
WantedBy=multi-user.target


