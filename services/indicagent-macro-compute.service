[Unit]
Description=IndicAgent Macro Factors Service — Yield curve, flight-to-quality, USD strength
Documentation=https://github.com/brandonio/indicagent
After=network.target redpanda.service timescaledb.service
Wants=timescaledb.service

[Service]
Type=simple
User=indicant
Group=indicant
WorkingDirectory=/home/indicant/indicagent
Environment="PATH=/home/indicant/indicagent/.venv/bin:/usr/bin:/bin"
EnvironmentFile=-/home/indicant/indicagent/.env
ExecStart=/home/indicant/indicagent/.venv/bin/python services/macro_compute_agent.py
Restart=always
RestartSec=10

# Logs go to file (setup_service_logging), NOT journald
StandardOutput=null
StandardError=journal

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
